// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  INPROGRESS
  CLOSED
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  avatar   String?
  role     String  @default("ADMIN")

  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id String @id @default(cuid())

  title   String
  slug    String  @unique
  excerpt String?
  content String

  featured Boolean @default(false)

  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInquiry {
  id String @id @default(cuid())

  name     String
  email    String
  phone    String?
  website  String?
  visitorId String?
  leadSource String?
  leadMedium String?
  leadCampaign String?
  leadAdSet String?
  leadAd String?
  leadLandingPage String?
  leadReferrer String?
  source   String   @default("Contact")
  services String[]
  budget   String?
  timeline String?
  message  String

  status InquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
  @@index([leadSource])
  @@index([leadCampaign])
}

model GrowthAuditInquiry {
  id String @id @default(cuid())

  name         String
  email        String
  website      String
  visitorId    String?
  leadSource   String?
  leadMedium   String?
  leadCampaign String?
  leadAdSet    String?
  leadAd       String?
  leadLandingPage String?
  leadReferrer String?
  revenueRange String
  goal         String

  status InquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
  @@index([leadSource])
  @@index([leadCampaign])
}

model VisitorEvent {
  id        String   @id @default(cuid())
  visitorId String
  eventName String
  path      String
  pageTitle String?
  referrer  String?
  params    Json     @default("{}")
  userAgent String?

  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([eventName])
  @@index([createdAt])
}

model BlogDraft {
  id String @id @default(cuid())

  title          String  @default("")
  slug           String  @default("")
  excerpt        String  @default("")
  content        String  @default("")
  readTime       String  @default("")
  seoDescription String  @default("")
  status         String  @default("DRAFT")
  featured       Boolean @default(false)
  category       String[]
  tags           String[]
  featuredImage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

